RewriteEngine On
RewriteBase /

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve the redesigned Bootstrap 5 interface for browser-facing pages.
RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^(?:$|ui/?$|ui/mod/[^/]+$|ui/admin/?$|developers/?$|install/?$) ui.php [L,QSA]

RewriteRule ^ index.php [L,QSA]
